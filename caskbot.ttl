@prefix : <http://www.w3id.org/hsu-aut/caskbot#> .
@prefix CSS: <http://www.w3id.org/hsu-aut/css#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix CaSk: <http://www.w3id.org/hsu-aut/cask#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CORA: <http://purl.org/ieee1872-owl/cora-bare#> .
@prefix CORAX: <http://purl.org/ieee1872-owl/corax#> .
@prefix POS: <http://purl.org/ieee1872-owl/pos#> .
@prefix SUMO: <http://purl.org/ieee1872-owl/sumo-cora#> .
@prefix VDI2206: <http://www.w3id.org/hsu-aut/VDI2206#> .
@prefix VDI3682: <http://www.w3id.org/hsu-aut/VDI3682#> .
@prefix AuR: <http://w3id.org/hsu-aut/IEEE1872-2#> .
@prefix RobotCap: <http://www.w3id.org/hsu-aut/RobotCapabilities#> .
@prefix WADL: <http://www.w3id.org/hsu-aut/WADL#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://www.w3id.org/hsu-aut/caskbot#> .

<http://www.w3id.org/hsu-aut/caskbot#> rdf:type owl:Ontology ;
                                        owl:versionIRI <http://www.w3id.org/hsu-aut/caskbot/1.23.0#> ;
                                        owl:imports <http://purl.org/ieee1872-owl/cora> ,
                                                    <http://purl.org/ieee1872-owl/pos> ,
                                                    <http://w3id.org/hsu-aut/IEEE1872-2/3.0.0> ,
                                                    <http://www.w3id.org/hsu-aut/RobotCapabilities/1.0.0> ,
                                                    <http://www.w3id.org/hsu-aut/WADL/2.0.0> ,
                                                    <http://www.w3id.org/hsu-aut/cask/5.2.0> ;
                                        rdfs:comment "CaSkBot is part of a three-level ontology architecture for modelling capabilities and skills for autonomous robots (including UAV, UGV and USV). It is based on the CSS and CaSk ontologies and extends the CaSk ontology by the IEEE 1872 (CORA, CORAX, RPARTS, POS) and IEEE 1872.2 standards to represent autonomous robots, their structure, position, environment and interactions. Skill interfaces based on RESTful web services are aligned with the WADL ODP, so that the call address of a skill is part of the model; the MQTT interface is planned but not yet aligned." ;
                                        owl:versionInfo "1.23.0" ;
                                        rdfs:label "CaSkBot"@en ;
                                        dcterms:title "CaSkBot - An Ontology for Capabilities and Skills of Heterogeneous Autonomous Robots"@en ;
                                        dcterms:description "CaSkBot is the robotics layer of the three-level CaSkade ontology architecture. It aligns the capability and skill model of CSS and CaSk with the robotics standards IEEE 1872 and IEEE 1872.2, so that autonomous robots, their structure, position, environment and interactions can be described together with the capabilities they provide."@en ;
                                        dcterms:creator "Luis Miguel Vieira da Silva" ;
                                        dcterms:publisher "Helmut-Schmidt-University, Institute of Automation Technology" ;
                                        dcterms:license <https://opensource.org/licenses/MIT> ;
                                        dcterms:created "2023-02-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
                                        dcterms:modified "2026-11-05"^^<http://www.w3.org/2001/XMLSchema#date> ;
                                        dcterms:bibliographicCitation "L. M. Vieira da Silva, A. Koecher, A. Fay: A capability and skill model for heterogeneous autonomous robots. at - Automatisierungstechnik 71(2), 2023, pp. 140-150. DOI 10.1515/auto-2022-0122" ;
                                        vann:preferredNamespacePrefix "caskbot" ;
                                        vann:preferredNamespaceUri "http://www.w3id.org/hsu-aut/caskbot#" ;
                                        rdfs:seeAlso <https://doi.org/10.1515/auto-2022-0122> .

#################################################################
#    Annotation properties used in the metadata
#################################################################
# Declared so that the ontology stays within OWL 2 DL: using an undeclared
# annotation property puts the imports closure out of profile.

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:creator rdf:type owl:AnnotationProperty .
dcterms:publisher rdf:type owl:AnnotationProperty .
dcterms:license rdf:type owl:AnnotationProperty .
dcterms:created rdf:type owl:AnnotationProperty .
dcterms:modified rdf:type owl:AnnotationProperty .
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


#################################################################
#
#    ALIGNMENT-MECHANISMEN
#
#    Nach Hildebrandt et al. (2020), Abschn. IV-C, gibt es vier Wege, eine
#    fremde TBox ohne Reconciliation zu erweitern. Jedes Alignment-Axiom unten
#    nennt den verwendeten Mechanismus. Verwendet werden hier:
#
#      subclassing    rdfs:subClassOf zwischen Klassen zweier ODPs -- Regelfall
#      Relation-to    neue Object Property zwischen zwei ODPs, wenn die
#                     Standards keine passende Relation anbieten
#      subclassing auf Property-Ebene
#                     rdfs:subPropertyOf zwischen zwei *fremden* Relationen.
#                     Nicht im Katalog von Hildebrandt, der nur Klassen
#                     behandelt; das Gegenstueck dazu fuer Relationen. Zu
#                     unterscheiden von Relation-to, wo eine *eigene* neue
#                     Relation unter eine fremde gehaengt wird (operatesIn,
#                     memberOfGroup usw.). Seit 1.21.0 einmal verwendet
#                     (VDI2206:isPartOf unter SUMO:part, ADR-017).
#
#    Nicht verwendet:
#
#      Equivalent-To  owl:equivalentClass -- zu stark ueber ODP-Grenzen hinweg,
#                     nur mit ADR (siehe F-005, F-007, F-020)
#      attribute-to-class  bisher kein Anlass
#
#    Der Matcher ist laut Hildebrandt immer projektspezifisch: Ein Alignment
#    wird nicht vollstaendig gemacht, sondern genau so weit, wie die
#    Competency Questions es verlangen.
#
#################################################################


#################################################################
#
#    ASPEKT STRUKTUR
#
#    Verbindet die Roboterbegriffe aus IEEE 1872 (CORA) mit der
#    mechatronischen Systembeschreibung aus VDI 2206 und damit mit der
#    Ressourcen- und Fähigkeitsseite aus VDI 3682 und CSS.
#
#    Deckt CQ-01 bis CQ-06, Anforderungen A1, A3, A5, A6.
#
#################################################################

#################################################################
#    Classes
#################################################################

###  http://purl.org/ieee1872-owl/cora-bare#Robot
# Ein Roboter ist ein mechatronisches System im Sinne der VDI 2206. Damit
# greift die in CaSk bestehende Kette
#     VDI2206:System -> VDI3682:TechnicalResource -> CSS:Resource
# und ein Roboter kann über CSS:providesCapability Fähigkeiten anbieten.
# Das ist die zentrale Naht zwischen der Robotik- und der Fähigkeitsseite.
#
# Hinweis: Die Publikation schreibt "Robot subClassOf MechatronicSystem".
# Eine Klasse dieses Namens gibt es im VDI-2206-ODP nicht; sie heißt System
# (siehe F-014).
# Mechanismus: subclassing (IEEE 1872 -> VDI 2206)
CORA:Robot rdfs:subClassOf VDI2206:System .


###  http://www.w3id.org/hsu-aut/caskbot#AutonomousRobot
# Eigene Klasse, weil weder CORA noch IEEE 1872.2 einen Begriff anbieten, der
# autonome von ferngesteuerten Robotern unterscheidet. CORA hätte dafür die
# Properties agentRobot/fullyautonomousRobot vorgesehen, die jedoch
# unerfüllbar sind (F-002) und deshalb nicht genutzt werden können.
:AutonomousRobot rdf:type owl:Class ;
                 rdfs:subClassOf CORA:Robot ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty VDI2206:SystemConsistsOfModule ;
                                   owl:someValuesFrom :Platform
                                 ] ;
                 rdfs:label "autonomous robot"@en ;
                 rdfs:comment "A robot that is able to perform its tasks without continuous external control. Every autonomous robot consists of at least one platform that provides its locomotion. Defined in CaSkBot because IEEE 1872 expresses degrees of autonomy through object properties that are unsatisfiable in the published OWL implementation."@en ;
                 rdfs:seeAlso <http://purl.org/ieee1872-owl/cora-bare#fullyautonomousRobot> .


###  http://www.w3id.org/hsu-aut/caskbot#Platform
# Die Plattform trägt die Fortbewegungsart und damit die Modalität. Sie ist
# ein Modul im Sinne der VDI 2206 und kann so aus Komponenten bestehen.
:Platform rdf:type owl:Class ;
          rdfs:subClassOf VDI2206:Module ;
          rdfs:label "platform"@en ;
          rdfs:comment "The subsystem of a robot that provides its locomotion and determines its modality (air, ground, water)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#AerialPlatform
:AerialPlatform rdf:type owl:Class ;
                rdfs:subClassOf :Platform ;
                rdfs:label "aerial platform"@en ;
                rdfs:comment "Platform of an unmanned aerial vehicle (UAV)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#GroundPlatform
:GroundPlatform rdf:type owl:Class ;
                rdfs:subClassOf :Platform ;
                rdfs:label "ground platform"@en ;
                rdfs:comment "Platform of an unmanned ground vehicle (UGV)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#SurfacePlatform
:SurfacePlatform rdf:type owl:Class ;
                 rdfs:subClassOf :Platform ;
                 rdfs:label "surface platform"@en ;
                 rdfs:comment "Platform of an unmanned surface vehicle (USV)."@en .


###  http://www.w3id.org/hsu-aut/VDI2206#Component
# Komponenten eines Roboters sind Geräte im Sinne von SUMO. Erst dadurch
# erfüllen Sensoren, Aktoren und Steuerungen die Domain von CORA:robotPart
# und lassen sich einem Roboter zuordnen.
# Mechanismus: subclassing (VDI 2206 -> SUMO)
VDI2206:Component rdfs:subClassOf SUMO:Device .


###  http://www.w3id.org/hsu-aut/VDI2206#isPartOf
# Die Teil-Hierarchien der beiden Standards haengen zusammen: Ohne dieses Axiom
# beschreibt das Modell die Struktur eines Roboters in zwei Baeumen, zwischen
# denen keine Aussage besteht -- IEEE 1872 mit SUMO:part und CORA:robotPart,
# VDI 2206 mit isPartOf/consistsOf. Eine Abfrage ueber den einen findet die
# Teile des anderen nicht: CQ-02 fand die Plattform nicht, obwohl sie das
# groesste Bauteil ist (F-068, ADR-017).
#
# Leserichtung geprueft: isPartOf laeuft vom Teil zum Ganzen (Domain Component,
# Range Module bzw. System), SUMO:part ebenso -- SUMO legt
# (domain part 1 Object) (domain part 2 Object) fest und liest part(Teil,
# Ganzes). Dieselbe Richtung wie CORA:robotPart (F-014).
#
# Zulaessig: SUMO:part traegt in der OWL-Fassung von IEEE 1872 weder Domain noch
# Range (F-063), wird in keiner Restriktion verwendet und ist weder asymmetrisch
# noch irreflexiv -- es wird also keine Zusicherung verletzt. Dass VDI2206:isPartOf
# transitiv ist, macht SUMO:part non-simple; das ist unschaedlich, weil SUMO:part
# nirgends in einer Kardinalitaets-, Asymmetrie- oder Irreflexivitaetsangabe
# vorkommt. SUMO:member bleibt simple und damit zulaessig asymmetrisch, weil
# Nicht-Simplizitaet nach unten und nicht nach oben vererbt wird.
# Am Profilpruefer belegt: keine neue OWL-2-DL-Verletzung.
#
# Mechanismus: subclassing auf Property-Ebene (VDI 2206 -> SUMO). Hildebrandt
# u. a. (2020), Abschn. IV-C nennt nur das Subclassing von Klassen; dies ist
# dessen Gegenstueck fuer Relationen. Erster Fall in CaSkBot, in dem zwei
# *fremde* Relationen verbunden werden -- die uebrigen subPropertyOf-Axiome
# haengen eine eigene Relation unter eine fremde (Relation-to).
VDI2206:isPartOf rdfs:subPropertyOf SUMO:part .


###  http://www.w3id.org/hsu-aut/caskbot#RestrictedZone
# Anforderung A6 verlangt ausdrücklich Randbedingungen wie Sperrzonen. POS
# stellt mit PositionRegion das räumliche Gebiet bereit; die Bedeutung
# "hier darf nicht operiert werden" ist dort nicht vorgesehen und wird hier
# ergänzt.
:RestrictedZone rdf:type owl:Class ;
                rdfs:subClassOf POS:PositionRegion ;
                rdfs:label "restricted zone"@en ;
                rdfs:comment "A spatial region within an environment that a robot must not enter, such as a no-fly zone or a safety area around humans."@en .


#################################################################
#
#    ALIGNMENT MIT IEEE 1872.2 (AuR)
#
#    IEEE 1872 und IEEE 1872.2 beschreiben teils dieselben Sachverhalte,
#    ordnen sie aber unterschiedlich ein. Die Verbindungen werden hier
#    hergestellt; der Standard selbst stellt sie nicht her.
#
#################################################################

###  http://w3id.org/hsu-aut/IEEE1872-2#ObjectCenteredEnvironment
# Eine objektzentrierte Umgebung ist eine physische Umgebung -- nur eben aus
# der Sicht eines bestimmten Objekts. IEEE 1872.2, Abschn. 4.4.2 beschreibt sie
# ausdruecklich als "a physical object comprising all the entities ... that
# could potentially interact with the object".
#
# Typvertraeglich: ObjectCenteredEnvironment ⊑ DUL:PhysicalObject, und das ODP
# setzt DUL:PhysicalObject ≡ sumo-cora:CorpuscularObject ⊑ ... ⊑ SUMO:Object,
# worunter auch CORAX:PhysicalEnvironment liegt.
# Mechanismus: subclassing (IEEE 1872.2 -> IEEE 1872 CORAX)
AuR:ObjectCenteredEnvironment rdfs:subClassOf CORAX:PhysicalEnvironment .


###  http://purl.org/ieee1872-owl/cora-bare#RoboticSystem
# Auch ein robotisches System bietet Faehigkeiten an, nicht nur ein einzelner
# Roboter. Ohne diese Verknuepfung koennte ein Verbund -- ein
# CollectiveRoboticSystem -- keine Capability tragen, weil CSS:providesCapability
# eine CSS:Resource verlangt. Fuer eine Arbeit ueber Verbuende waere das Modell
# damit an der entscheidenden Stelle unbrauchbar.
#
# CORA haengt RoboticSystem unter CORAX:ArtificialSystem; die Verbindung zur
# Faehigkeitsseite stellt erst dieses Alignment her.
# Mechanismus: subclassing (IEEE 1872 -> VDI 3682)
CORA:RoboticSystem rdfs:subClassOf VDI3682:TechnicalResource .


###  http://purl.org/ieee1872-owl/cora-bare#RobotGroup
# Dasselbe fuer die Robotergruppe: Eine Gruppe verfolgt laut CORA gemeinsam ein
# Ziel und muss daher als Ganzes Faehigkeiten anbieten koennen.
# Mechanismus: subclassing (IEEE 1872 -> VDI 3682)
CORA:RobotGroup rdfs:subClassOf VDI3682:TechnicalResource .


###  http://purl.org/ieee1872-owl/corax#ProcessingDevice
# Die informationsverarbeitende Komponente eines mechatronischen Systems nach
# VDI 2206 und das ProcessingDevice aus CORAX bezeichnen dieselbe Sache aus zwei
# Blickwinkeln. Ohne Verknuepfung liessen sich Rechner eines Roboters in der
# einen oder der anderen Taxonomie einordnen, ohne dass das Modell beides
# zusammenbrachte.
# Mechanismus: subclassing (IEEE 1872 CORAX -> VDI 2206)
CORAX:ProcessingDevice rdfs:subClassOf VDI2206:InformationProcessing .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3id.org/hsu-aut/caskbot#hasObjectCenteredEnvironment
# Die objektzentrierte Umgebung eines Roboters. Spezialisierung von
# operatesIn: Ein Roboter operiert in einer Umgebung, und die aus seiner Sicht
# modellierte ist eine davon.
# Mechanismus: Relation-to (IEEE 1872 CORA <-> IEEE 1872.2)
:hasObjectCenteredEnvironment rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :operatesIn ;
                              rdfs:domain CORA:Robot ;
                              rdfs:range AuR:ObjectCenteredEnvironment ;
                              rdfs:label "has object-centered environment"@en ;
                              rdfs:comment "Relates a robot to its own model of the environment, in the sense of IEEE 1872.2, 4.4.2. Two robots in the same room have different object-centered environments if their perception and navigation differ."@en .


###  http://www.w3id.org/hsu-aut/caskbot#describesEnvironment
# IEEE 1872.2 definiert in 4.4.3 die Umgebungsbeschreibung und die externe
# Umgebungsbeschreibung, aber **keine Relation zu der Umgebung, die sie
# beschreiben** -- obwohl genau das ihr Zweck ist. Die Beziehung steht nur in
# der Prosadefinition, nicht in der Axiomatik. Ohne sie haengen beide Klassen
# als reine Huellen im Modell.
# Mechanismus: Relation-to (innerhalb IEEE 1872.2, dort nicht axiomatisiert)
:describesEnvironment rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isAbout> ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( AuR:ObjectCenteredEnvironmentDescription
                                                  AuR:ObjectCenteredExternalEnvironmentDescription
                                                )
                                  ] ;
                      rdfs:range AuR:ObjectCenteredEnvironment ;
                      rdfs:label "describes environment"@en ;
                      rdfs:comment "Relates an object-centered environment description to the environment it describes. IEEE 1872.2, 4.4.3 defines both description classes but no relation to the environment itself; this supplies it."@en .


###  http://www.w3id.org/hsu-aut/caskbot#correspondsToFunction
# Verbindet die Faehigkeitsseite mit dem Funktionsmodell von IEEE 1872.2.
#
# Die Publikation setzt hier ProcessOperator = Function. Das ist ein
# Kategorienfehler (F-022): Ein ProcessOperator ist ein Prozessschritt, der
# einen Zustand in einen anderen ueberfuehrt; AuR:Function ist die *Rolle*, die
# ein Verhalten in einem Ereignis spielt, formal eine DUL:Role. Eine Operation
# und eine Rolle sind nicht dasselbe, und eine Gleichsetzung zoege das gesamte
# DUL-Rollenmodell in das Faehigkeitsmodell.
#
# Stattdessen eine gerichtete Relation: Zu einer Faehigkeit gehoert die Rolle,
# die das sie realisierende Verhalten spielt. Zusammen mit exhibitsBehavior
# (Roboter -> ManifestedBehavior) und AuR:isPlayedBy (Function -> nur
# ManifestedBehavior) schliesst das den Bogen von "was kann der Roboter" zu
# "was tut er gerade" -- die Ueberwachungsseite der alten A4 (CQ-29).
# Seit ADR-011 ohne Anforderungsbezug, Entscheidung in ADR-012.
#
# Mechanismus: Relation-to (CSS <-> IEEE 1872.2)
:correspondsToFunction rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                       rdfs:domain CSS:Capability ;
                       rdfs:range AuR:Function ;
                       rdfs:label "corresponds to function"@en ;
                       rdfs:comment "Relates a capability to the function role that the behavior realising it plays, in the sense of IEEE 1872.2, 4.4.9. A directed relation rather than the equivalence stated in the publication: a process operator is a process step, a function is a role, and the two are not the same kind of thing."@en .


###  http://www.w3id.org/hsu-aut/caskbot#exhibitsBehavior
# Verbindet einen Roboter mit dem Verhalten, das er zeigt.
#
# In 1.8.0 war diese Relation entfernt worden, weil keine Anforderung sie
# verlangt (ADR-008). Nach dem Kriterium der Alignment-Vollstaendigkeit
# (ADR-009) war das falsch: Ohne sie haengt das gesamte Verhaltensmodell von
# IEEE 1872.2 -- Behavior und seine fuenf Arten -- ohne Zugang von der
# Roboterseite im Modell. Ein importiertes ODP, das sich nicht erreichen
# laesst, ist totes Gewicht.
#
# Bewusst auf ManifestedBehavior eingeschraenkt: Nur diese Verhaltensart ist
# eine Qualitaet (⊑ AuR:Interaction ⊑ DUL:Quality) und damit als Range von
# DUL:hasQuality zulaessig. EngineeringBehavior und EmergentBehavior sind
# InformationObjects, RuleBehavior ist ein PhysicalObject.
# Mechanismus: Relation-to (IEEE 1872 CORA <-> IEEE 1872.2)
:exhibitsBehavior rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality> ;
                  rdfs:domain CORA:Robot ;
                  rdfs:range AuR:ManifestedBehavior ;
                  rdfs:label "exhibits behavior"@en ;
                  rdfs:comment "Relates a robot to a manifested behavior it shows in an event, in the sense of IEEE 1872.2, 4.4.4."@en .


###  http://www.w3id.org/hsu-aut/caskbot#qualityOfInteraction
# Bruecke zwischen den beiden Interaktionsbegriffen der IEEE-Standards.
#
# CORAX:Interaction ist ein Prozess (⊑ SUMO:Process ≡ DUL:Event),
# AuR:Interaction ist eine Qualitaet (⊑ SUMO:Attribute ≡ DUL:Quality),
# und DUL erklaert Event und Quality fuer disjunkt. Die beiden Klassen sind
# damit notwendig verschieden -- eine Gleichsetzung machte beide unerfuellbar
# (siehe F-020).
#
# Es ist aber kein Widerspruch, sondern eine andere Reifizierung: IEEE 1872.2
# fasst die Interaktion als Qualitaet des Ereignisses, in dem die Objekte
# teilnehmen (Abschn. 4.4.1). Genau diese Beziehung wird hier ausgedrueckt.
# Mechanismus: Relation-to (IEEE 1872.2 <-> IEEE 1872 CORAX)
:qualityOfInteraction rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isQualityOf> ;
                      rdfs:domain AuR:Interaction ;
                      rdfs:range CORAX:Interaction ;
                      rdfs:label "quality of interaction"@en ;
                      rdfs:comment "Relates an interaction in the sense of IEEE 1872.2 -- a quality of an event -- to the interaction process it qualifies in the sense of IEEE 1872 CORAX. The two standards reify interaction differently; this property bridges them without equating the classes, which would be inconsistent."@en .


###  http://www.w3id.org/hsu-aut/caskbot#operatesIn
# Neue Relation, weil IEEE 1872 keine passende anbietet: CORA:equippedWith
# verbindet eine RoboticEnvironment mit einem RoboticSystem. Ein Robot ist
# laut IEEE 1872 aber kein RoboticSystem, sondern dessen Bestandteil
# (RoboticSystem ≡ SingleRoboticSystem ⊔ CollectiveRoboticSystem). Für die
# Frage "in welcher Umgebung operiert dieser Roboter" (CQ-06) fehlt damit ein
# direkter Weg, ohne für jeden Roboter ein umschließendes Systemindividuum
# anlegen zu müssen.
#
# Die Relation haengt unter DUL:hasLocation. Eine umgebungsspezifische Relation
# bieten die Standards nicht, eine generische Verortung aber schon (daneben
# SUMO:located und SUMO:partlyLocated). Eine eigene Relation gehoert in das
# Standardvokabular eingehaengt, nicht frei daneben gestellt.
# Mechanismus: Relation-to (IEEE 1872 CORA <-> CORAX)
:operatesIn rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasLocation> ;
            rdfs:domain CORA:Robot ;
            rdfs:range CORAX:PhysicalEnvironment ;
            rdfs:label "operates in"@en ;
            rdfs:comment "Relates a robot to the environment it operates in. Introduced in CaSkBot because CORA:equippedWith relates an environment to robotic systems rather than to individual robots. Anchored under DUL:hasLocation, since the standards offer no robot-to-environment relation but do offer a generic notion of being located somewhere, of which this is a specialisation."@en ;
            rdfs:seeAlso CORA:equippedWith .


###  http://www.w3id.org/hsu-aut/caskbot#hasRestrictedZone
# Mechanismus: Relation-to (IEEE 1872 CORAX <-> eigene Klasse)
:hasRestrictedZone rdf:type owl:ObjectProperty ;
                   rdfs:domain CORAX:PhysicalEnvironment ;
                   rdfs:range :RestrictedZone ;
                   rdfs:label "has restricted zone"@en ;
                   rdfs:comment "Relates an environment to a region within it that robots must not enter."@en .


###  http://www.w3id.org/hsu-aut/caskbot#memberOfGroup
# SUMO:member ist Subproperty von part und traegt weder Domain noch Range.
# Die Leserichtung folgt part und robotPart: Teil -> Ganzes, hier also
# Roboter -> Gruppe.
# Mechanismus: Relation-to (Spezialisierung von SUMO:member)
:memberOfGroup rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf SUMO:member ;
               rdfs:domain CORA:Robot ;
               rdfs:range CORA:RobotGroup ;
               rdfs:label "member of group"@en ;
               rdfs:comment "Relates a robot to a robot group it belongs to. Read as part-to-whole, consistent with SUMO:member and CORA:robotPart."@en .


#################################################################
#
#    ALIGNMENT MIT WADL (REST-Aufrufschnittstelle)
#
#    CSS kennt die Aufrufschnittstelle eines Skills (CSS:SkillInterface), CaSk
#    den technologieoffenen Ausloeser (CaSk:SkillMethod, Kommentar dort:
#    "Needs to be implemented and modeled in detail for a specific
#    technology"). Was beide nicht sagen, ist die Adresse: Basis-URI, Pfad und
#    HTTP-Verb. Genau das beschreibt WADL, und nur dieser Teil wird aligned
#    (CQ-17, CQ-36 -- Anforderung A4).
#
#    Nicht aligned wird die Parameterseite von WADL. CaSk fuehrt auf
#    CSS:SkillParameter bereits hasVariableName, hasVariableType,
#    hasDefaultValue, hasOptionValue und isRequired; WADL:Parameter doppelt das
#    vollstaendig. Eine zweite Beschreibung desselben Sachverhalts ohne CQ
#    waere ein Verstoss gegen Regel 6 -- begruendet in ADR-019.
#
#    WADL ist eine Beschreibungssprache: Resources, Resource und Method sind
#    Elemente eines Dokuments, nicht die Schnittstelle selbst. Ein
#    subclassing-Axiom zwischen RestSkillInterface und einer WADL-Klasse waere
#    deshalb falsch -- dieselbe Unterscheidung, die IEEE 1872.2 zwischen
#    Umgebung und Umgebungsbeschreibung macht. Zur WADL-Seite also
#    durchgehend Relation-to.
#
#################################################################

###  http://www.w3id.org/hsu-aut/caskbot#RestSkillInterface
# Mechanismus: subclassing (CSS <-> eigene Klasse). Gleich benannt wie
# CaSkMan:RestSkillInterface, damit die dritte Ebene einheitlich bleibt.
:RestSkillInterface rdf:type owl:Class ;
                    rdfs:subClassOf CSS:SkillInterface ;
                    rdfs:label "REST skill interface"@en ;
                    rdfs:comment "A skill interface that is accessed as a RESTful web service over HTTP. Its address is described with the WADL ODP: the base URI comes from the resources element, the path from a resource and the verb from a method (WADL, W3C Member Submission 31 August 2009, 2.6 to 2.8)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#accessibleThroughRestInterface
# Mechanismus: Relation-to (CSS <-> eigene Klasse), wortgleich zu
# CaSkMan:accessibleThroughRestInterface.
:accessibleThroughRestInterface rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf CSS:accessibleThrough ;
                                rdfs:domain CSS:Skill ;
                                rdfs:range :RestSkillInterface ;
                                rdfs:label "accessible through REST interface"@en ;
                                rdfs:comment "Relates a skill to a REST interface through which it can be invoked. Specialisation of CSS:accessibleThrough and the technology part of the answer to CQ-17."@en .


###  http://www.w3id.org/hsu-aut/caskbot#describesRestSkillInterface
# Mechanismus: Relation-to (WADL <-> CSS). Richtung Beschreibung ->
# Beschriebenes, wie bei :describesEnvironment. WADL bietet keine solche
# Relation an, weil ein WADL-Dokument nichts von Skills weiss.
:describesRestSkillInterface rdf:type owl:ObjectProperty ;
                             rdfs:domain WADL:Resources ;
                             rdfs:range :RestSkillInterface ;
                             rdfs:label "describes REST skill interface"@en ;
                             rdfs:comment "Relates a WADL resources element to the REST skill interface it describes. The base attribute of that element carries the address under which the interface is reachable (WADL 2.6). This is a relation and not a subclass axiom, because a WADL element describes an interface but is not one."@en .


###  http://www.w3id.org/hsu-aut/caskbot#invokedByHttpMethod
# Mechanismus: Relation-to (CaSk <-> WADL). Bewusst ohne Oberproperty:
# CSS:isRealizedBy traegt eine Domain-Union ohne SkillMethod, ein Unterhaengen
# wuerde CaSk:SkillMethod faelschlich in diese Union zwingen.
:invokedByHttpMethod rdf:type owl:ObjectProperty ;
                     rdfs:domain CaSk:SkillMethod ;
                     rdfs:range WADL:Method ;
                     rdfs:label "invoked by HTTP method"@en ;
                     rdfs:comment "Relates a skill method, which is the technology-independent trigger of a state transition in CaSk, to the HTTP method that invokes it. Together with the path of the WADL resource carrying that method and the base URI of the enclosing resources element, this gives the complete call address (CQ-36)."@en .


#################################################################
#    Disjunktheit
#################################################################

# Eine Plattform ist genau einer Modalität zugeordnet. Ohne diese Aussage
# kann der Reasoner eine widersprüchliche Modellierung nicht erkennen.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AerialPlatform :GroundPlatform :SurfacePlatform )
] .


#################################################################
#
#    Position, Orientierung und Pose -- ohne eigene Axiome
#
#    POS stellt bereits alles bereit, was A5 verlangt:
#        positionedAt  Object -> PositionMeasure
#        orientedAt    Object -> OrientationMeasure
#        pose          Object -> PoseMeasure
#        posePosition  PoseMeasure -> PositionMeasure
#        poseOrientation PoseMeasure -> OrientationMeasure
#        inPCS / inOCS   Bezugssystem, beide funktional
#        refPCS / refOCS Verankerung eines Koordinatensystems an einem Objekt
#
#    Alle drei Zuordnungsproperties haben Domain sumo-cora:Object, und es gilt
#        Robot ⊑ Device ⊑ Artifact ⊑ CorpuscularObject
#              ⊑ SelfConnectedObject ⊑ Object
#    Ein Alignment-Axiom waere hier also redundant und wuerde nur Rauschen
#    erzeugen (CLAUDE.md Regel 6).
#
#    Dass ein Roboter eine Position HABEN MUSS, ist keine OWL-Aussage: In der
#    offenen Welt erzeugt eine Existenzrestriktion keinen Pruefdruck. Diese
#    Vollstaendigkeitsforderung gehoert nach constraints/ als SHACL-Shape.
#
#################################################################


