@prefix : <http://www.w3id.org/hsu-aut/caskbot#> .
@prefix CSS: <http://www.w3id.org/hsu-aut/css#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix CaSk: <http://www.w3id.org/hsu-aut/cask#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix CORA: <http://purl.org/ieee1872-owl/cora-bare#> .
@prefix CORAX: <http://purl.org/ieee1872-owl/corax#> .
@prefix POS: <http://purl.org/ieee1872-owl/pos#> .
@prefix SUMO: <http://purl.org/ieee1872-owl/sumo-cora#> .
@prefix VDI2206: <http://www.w3id.org/hsu-aut/VDI2206#> .
@prefix VDI3682: <http://www.w3id.org/hsu-aut/VDI3682#> .
@prefix AuR: <http://w3id.org/hsu-aut/IEEE1872-2#> .
@prefix RobotCap: <http://www.w3id.org/hsu-aut/RobotCapabilities#> .
@prefix WADL: <http://www.w3id.org/hsu-aut/WADL#> .
@prefix MQTT: <http://www.w3id.org/hsu-aut/MQTT#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://www.w3id.org/hsu-aut/caskbot#> .

<http://www.w3id.org/hsu-aut/caskbot#> rdf:type owl:Ontology ;
                                        owl:versionIRI <http://www.w3id.org/hsu-aut/caskbot/2.0.0#> ;
                                        owl:imports <http://purl.org/ieee1872-owl/cora> ,
                                                    <http://purl.org/ieee1872-owl/pos> ,
                                                    <https://raw.githubusercontent.com/opengeospatial/ogc-geosparql/019821868049d4710c0ba31578ab16c8c1b46e6c/geosparql11/geo.ttl> ,
                                                    <http://w3id.org/hsu-aut/IEEE1872-2/3.0.0> ,
                                                    <http://www.w3id.org/hsu-aut/MQTT/6.0.1> ,
                                                    <http://www.w3id.org/hsu-aut/RobotCapabilities/2.0.2> ,
                                                    <http://www.w3id.org/hsu-aut/WADL/2.0.0> ,
                                                    <http://www.w3id.org/hsu-aut/cask/5.2.0> ;
                                        rdfs:comment "CaSkBot is part of a three-level ontology architecture for modelling capabilities and skills for autonomous robots (including UAV, UGV and USV). It is based on the CSS and CaSk ontologies and extends the CaSk ontology by the IEEE 1872 (CORA, CORAX, RPARTS, POS) and IEEE 1872.2 standards to represent autonomous robots, their structure, position, environment and interactions. Skill interfaces are aligned with the WADL and the MQTT ODP, so that the call address of a skill is part of the model, whether it is reached over HTTP or over a publish/subscribe broker. The spatial extent of a zone is given as a GeoSPARQL geometry." ;
                                        owl:versionInfo "2.0.0" ;
                                        rdfs:label "CaSkBot"@en ;
                                        dcterms:title "CaSkBot - An Ontology for Capabilities and Skills of Heterogeneous Autonomous Robots"@en ;
                                        dcterms:description "CaSkBot is the robotics layer of the three-level CaSkade ontology architecture. It aligns the capability and skill model of CSS and CaSk with the robotics standards IEEE 1872 and IEEE 1872.2, so that autonomous robots, their structure, position, environment and interactions can be described together with the capabilities they provide."@en ;
                                        dcterms:creator "Luis Miguel Vieira da Silva" ;
                                        dcterms:publisher "Helmut-Schmidt-University, Institute of Automation Technology" ;
                                        dcterms:license <https://opensource.org/licenses/MIT> ;
                                        dcterms:created "2023-02-01"^^<http://www.w3.org/2001/XMLSchema#date> ;
                                        dcterms:modified "2026-11-06"^^<http://www.w3.org/2001/XMLSchema#date> ;
                                        dcterms:bibliographicCitation "L. M. Vieira da Silva, A. Koecher, A. Fay: A capability and skill model for heterogeneous autonomous robots. at - Automatisierungstechnik 71(2), 2023, pp. 140-150. DOI 10.1515/auto-2022-0122" ;
                                        vann:preferredNamespacePrefix "caskbot" ;
                                        vann:preferredNamespaceUri "http://www.w3id.org/hsu-aut/caskbot#" ;
                                        rdfs:seeAlso <https://doi.org/10.1515/auto-2022-0122> .

#################################################################
#    Annotation properties used in the metadata
#################################################################
# Declared so that the ontology stays within OWL 2 DL: using an undeclared
# annotation property puts the imports closure out of profile.

dcterms:title rdf:type owl:AnnotationProperty .
dcterms:description rdf:type owl:AnnotationProperty .
dcterms:creator rdf:type owl:AnnotationProperty .
dcterms:publisher rdf:type owl:AnnotationProperty .
dcterms:license rdf:type owl:AnnotationProperty .
dcterms:created rdf:type owl:AnnotationProperty .
dcterms:modified rdf:type owl:AnnotationProperty .
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


#################################################################
#
#    ALIGNMENT MECHANISMS
#
#    Hildebrandt et al. (2020), IV-C, name four ways of extending a foreign
#    TBox without reconciliation. Every alignment axiom below names the
#    mechanism it uses:
#
#      subclassing    rdfs:subClassOf between classes of two patterns
#      Relation-to    a new object property between two patterns, where the
#                     standards offer no suitable relation
#      subclassing at property level
#                     rdfs:subPropertyOf between two foreign relations. Not in
#                     Hildebrandt's catalogue, which covers classes only; the
#                     counterpart for relations. Distinct from Relation-to,
#                     where a new relation of our own is placed under a
#                     foreign one.
#      Equivalent-To  owl:equivalentClass -- not used here
#
#    C. Hildebrandt et al.: Ontology Building for Cyber-Physical Systems:
#    Application in the Manufacturing Domain. IEEE Transactions on Automation
#    Science and Engineering, 2020.
#
#################################################################


#################################################################
#
#    STRUCTURE
#
#    Connects the robot vocabulary of IEEE 1872 (CORA) with the mechatronic
#    system description of VDI 2206, and through it with the resource and
#    capability side of VDI 3682 and CSS.
#
#################################################################

#################################################################
#    Classes
#################################################################

###  http://purl.org/ieee1872-owl/cora-bare#Robot
# A robot is a mechatronic system in the sense of VDI 2206. This engages the
# chain that CaSk already provides,
#     VDI2206:System -> VDI3682:TechnicalResource -> CSS:Resource
# so that a robot can offer capabilities through CSS:providesCapability. This
# is the central seam between the robotics and the capability side.
# Mechanism: subclassing (IEEE 1872 -> VDI 2206)
CORA:Robot rdfs:subClassOf VDI2206:System .


###  http://www.w3id.org/hsu-aut/caskbot#AutonomousRobot
# A class of our own, because neither CORA nor IEEE 1872.2 offers a term that
# distinguishes autonomous from remotely controlled robots.
:AutonomousRobot rdf:type owl:Class ;
                 rdfs:subClassOf CORA:Robot ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty VDI2206:SystemConsistsOfModule ;
                                   owl:someValuesFrom :Platform
                                 ] ;
                 rdfs:label "autonomous robot"@en ;
                 rdfs:comment "A robot that is able to perform its tasks without continuous external control. Every autonomous robot consists of at least one platform that provides its locomotion. Defined in CaSkBot because IEEE 1872 expresses degrees of autonomy through object properties that are unsatisfiable in the published OWL implementation."@en ;
                 rdfs:seeAlso <http://purl.org/ieee1872-owl/cora-bare#fullyautonomousRobot> .


###  http://www.w3id.org/hsu-aut/caskbot#Platform
# The platform carries the means of locomotion and thus the modality. It is a
# module in the sense of VDI 2206 and can therefore consist of components.
:Platform rdf:type owl:Class ;
          rdfs:subClassOf VDI2206:Module ;
          rdfs:label "platform"@en ;
          rdfs:comment "The subsystem of a robot that provides its locomotion and determines its modality (air, ground, water)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#AerialPlatform
:AerialPlatform rdf:type owl:Class ;
                rdfs:subClassOf :Platform ;
                rdfs:label "aerial platform"@en ;
                rdfs:comment "Platform of an unmanned aerial vehicle (UAV)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#GroundPlatform
:GroundPlatform rdf:type owl:Class ;
                rdfs:subClassOf :Platform ;
                rdfs:label "ground platform"@en ;
                rdfs:comment "Platform of an unmanned ground vehicle (UGV)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#SurfacePlatform
:SurfacePlatform rdf:type owl:Class ;
                 rdfs:subClassOf :Platform ;
                 rdfs:label "surface platform"@en ;
                 rdfs:comment "Platform of an unmanned surface vehicle (USV)."@en .


###  http://www.w3id.org/hsu-aut/VDI2206#Component
# Components of a robot are devices in the sense of SUMO. Only then do
# sensors, actuators and controllers satisfy the domain of CORA:robotPart and
# can be related to a robot.
# Mechanism: subclassing (VDI 2206 -> SUMO)
VDI2206:Component rdfs:subClassOf SUMO:Device .


###  http://www.w3id.org/hsu-aut/VDI2206#isPartOf
# Joins the part hierarchies of the two standards: IEEE 1872 uses SUMO:part
# and CORA:robotPart, VDI 2206 uses isPartOf and consistsOf. Without this
# axiom a query over the one does not find the parts described with the other.
#
# Both relations read from the part to the whole: isPartOf has domain
# Component and range Module or System, and SUMO defines
# (domain part 1 Object) (domain part 2 Object) with part(part, whole) -- the
# same direction as CORA:robotPart.
#
# Mechanism: subclassing at property level (VDI 2206 -> SUMO)
VDI2206:isPartOf rdfs:subPropertyOf SUMO:part .


###  http://www.w3id.org/hsu-aut/caskbot#RestrictedZone
# The kind of zone that forbids operation. Its spatial extent hangs on :Zone
# through geo:hasGeometry -- see the GeoSPARQL section.
:RestrictedZone rdf:type owl:Class ;
                rdfs:subClassOf :Zone ;
                rdfs:label "restricted zone"@en ;
                rdfs:comment "A zone within an environment that a robot must not enter, such as a no-fly zone or a safety area around humans."@en .


#################################################################
#
#    ALIGNMENT WITH IEEE 1872.2 (AuR)
#
#    IEEE 1872 and IEEE 1872.2 describe some of the same matters but classify
#    them differently. The standards do not relate the two; the axioms below
#    do.
#
#################################################################

###  http://w3id.org/hsu-aut/IEEE1872-2#ObjectCenteredEnvironment
# An object-centered environment is a physical environment, seen from the
# perspective of one object. IEEE 1872.2, 4.4.2 describes it as "a physical
# object comprising all the entities ... that could potentially interact with
# the object".
# Mechanism: subclassing (IEEE 1872.2 -> IEEE 1872 CORAX)
AuR:ObjectCenteredEnvironment rdfs:subClassOf CORAX:PhysicalEnvironment .


###  http://purl.org/ieee1872-owl/cora-bare#RoboticSystem
# A robotic system offers capabilities as well, not only a single robot.
# Without this axiom a collective robotic system could not carry a capability,
# because CSS:providesCapability requires a CSS:Resource. CORA places
# RoboticSystem under CORAX:ArtificialSystem and does not reach the capability
# side.
# Mechanism: subclassing (IEEE 1872 -> VDI 3682)
CORA:RoboticSystem rdfs:subClassOf VDI3682:TechnicalResource .


###  http://purl.org/ieee1872-owl/cora-bare#RobotGroup
# The same for a robot group: according to CORA a group pursues a common goal
# and therefore has to be able to offer capabilities as a whole.
# Mechanism: subclassing (IEEE 1872 -> VDI 3682)
CORA:RobotGroup rdfs:subClassOf VDI3682:TechnicalResource .


###  http://purl.org/ieee1872-owl/corax#ProcessingDevice
# The information-processing component of a mechatronic system in VDI 2206 and
# the processing device of CORAX name the same thing from two perspectives.
# Mechanism: subclassing (IEEE 1872 CORAX -> VDI 2206)
CORAX:ProcessingDevice rdfs:subClassOf VDI2206:InformationProcessing .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3id.org/hsu-aut/caskbot#hasObjectCenteredEnvironment
# The object-centered environment of a robot, a specialisation of operatesIn:
# a robot operates in an environment, and the one modelled from its own
# perspective is one of them.
# Mechanism: Relation-to (IEEE 1872 CORA <-> IEEE 1872.2)
:hasObjectCenteredEnvironment rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :operatesIn ;
                              rdfs:domain CORA:Robot ;
                              rdfs:range AuR:ObjectCenteredEnvironment ;
                              rdfs:label "has object-centered environment"@en ;
                              rdfs:comment "Relates a robot to its own model of the environment, in the sense of IEEE 1872.2, 4.4.2. Two robots in the same room have different object-centered environments if their perception and navigation differ."@en .


###  http://www.w3id.org/hsu-aut/caskbot#describesEnvironment
# IEEE 1872.2, 4.4.3 defines the environment description and the external
# environment description, but no relation to the environment they describe;
# that relation appears in the prose definition only.
# Mechanism: Relation-to (within IEEE 1872.2, not axiomatised there)
:describesEnvironment rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isAbout> ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( AuR:ObjectCenteredEnvironmentDescription
                                                  AuR:ObjectCenteredExternalEnvironmentDescription
                                                )
                                  ] ;
                      rdfs:range AuR:ObjectCenteredEnvironment ;
                      rdfs:label "describes environment"@en ;
                      rdfs:comment "Relates an object-centered environment description to the environment it describes. IEEE 1872.2, 4.4.3 defines both description classes but no relation to the environment itself; this supplies it."@en .


###  http://www.w3id.org/hsu-aut/caskbot#correspondsToFunction
# Connects the capability side with the function model of IEEE 1872.2: a
# capability has the role that the behavior realising it plays. Together with
# exhibitsBehavior (robot -> ManifestedBehavior) and AuR:isPlayedBy it spans
# from what a robot can do to what it is doing.
# Mechanism: Relation-to (CSS <-> IEEE 1872.2)
:correspondsToFunction rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#associatedWith> ;
                       rdfs:domain CSS:Capability ;
                       rdfs:range AuR:Function ;
                       rdfs:label "corresponds to function"@en ;
                       rdfs:comment "Relates a capability to the function role that the behavior realising it plays, in the sense of IEEE 1872.2, 4.4.9. A directed relation rather than the equivalence stated in the publication: a process operator is a process step, a function is a role, and the two are not the same kind of thing."@en .


###  http://www.w3id.org/hsu-aut/caskbot#exhibitsBehavior
# Relates a robot to the behavior it shows, and thereby makes the behavior
# model of IEEE 1872.2 reachable from the robot side.
#
# Restricted to ManifestedBehavior: only that kind of behavior is a quality
# (⊑ AuR:Interaction ⊑ DUL:Quality) and therefore admissible as the range of
# DUL:hasQuality. EngineeringBehavior and EmergentBehavior are information
# objects, RuleBehavior is a physical object.
# Mechanism: Relation-to (IEEE 1872 CORA <-> IEEE 1872.2)
:exhibitsBehavior rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality> ;
                  rdfs:domain CORA:Robot ;
                  rdfs:range AuR:ManifestedBehavior ;
                  rdfs:label "exhibits behavior"@en ;
                  rdfs:comment "Relates a robot to a manifested behavior it shows in an event, in the sense of IEEE 1872.2, 4.4.4."@en .


###  http://www.w3id.org/hsu-aut/caskbot#qualityOfInteraction
# Bridges the two notions of interaction of the IEEE standards.
# CORAX:Interaction is a process (⊑ SUMO:Process ≡ DUL:Event),
# AuR:Interaction is a quality (⊑ SUMO:Attribute ≡ DUL:Quality), and DUL
# declares event and quality disjoint. The two are therefore necessarily
# different classes; IEEE 1872.2, 4.4.1 reads the interaction as a quality of
# the event the objects participate in, and that is the relation stated here.
# Mechanism: Relation-to (IEEE 1872.2 <-> IEEE 1872 CORAX)
:qualityOfInteraction rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isQualityOf> ;
                      rdfs:domain AuR:Interaction ;
                      rdfs:range CORAX:Interaction ;
                      rdfs:label "quality of interaction"@en ;
                      rdfs:comment "Relates an interaction in the sense of IEEE 1872.2 -- a quality of an event -- to the interaction process it qualifies in the sense of IEEE 1872 CORAX. The two standards reify interaction differently; this property bridges them without equating the classes, which would be inconsistent."@en .


###  http://www.w3id.org/hsu-aut/caskbot#operatesIn
# A new relation, because IEEE 1872 offers none that fits: CORA:equippedWith
# relates a robotic environment to a robotic system, and a robot is not a
# robotic system but part of one. The relation is placed under
# DUL:hasLocation, the generic notion of being located somewhere.
# Mechanism: Relation-to (IEEE 1872 CORA <-> CORAX)
:operatesIn rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasLocation> ;
            rdfs:domain CORA:Robot ;
            rdfs:range CORAX:PhysicalEnvironment ;
            rdfs:label "operates in"@en ;
            rdfs:comment "Relates a robot to the environment it operates in. Introduced in CaSkBot because CORA:equippedWith relates an environment to robotic systems rather than to individual robots. Anchored under DUL:hasLocation, since the standards offer no robot-to-environment relation but do offer a generic notion of being located somewhere, of which this is a specialisation."@en ;
            rdfs:seeAlso CORA:equippedWith .


###  http://www.w3id.org/hsu-aut/caskbot#hasRestrictedZone
# Mechanism: Relation-to (IEEE 1872 CORAX <-> class of our own)
:hasRestrictedZone rdf:type owl:ObjectProperty ;
                   rdfs:domain CORAX:PhysicalEnvironment ;
                   rdfs:range :RestrictedZone ;
                   rdfs:label "has restricted zone"@en ;
                   rdfs:comment "Relates an environment to a zone within it that robots must not enter."@en .


###  http://www.w3id.org/hsu-aut/caskbot#hasOperatingZone
# Counterpart of :hasRestrictedZone for the permitted area.
# Mechanism: Relation-to (IEEE 1872 CORAX <-> class of our own)
:hasOperatingZone rdf:type owl:ObjectProperty ;
                  rdfs:domain CORAX:PhysicalEnvironment ;
                  rdfs:range :OperatingZone ;
                  rdfs:label "has operating zone"@en ;
                  rdfs:comment "Relates an environment to a zone within it in which robots may operate."@en .


###  http://www.w3id.org/hsu-aut/caskbot#memberOfGroup
# SUMO:member is a subproperty of part and carries neither domain nor range.
# The direction follows part and robotPart: part to whole, here robot to
# group.
# Mechanism: Relation-to (specialisation of SUMO:member)
:memberOfGroup rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf SUMO:member ;
               rdfs:domain CORA:Robot ;
               rdfs:range CORA:RobotGroup ;
               rdfs:label "member of group"@en ;
               rdfs:comment "Relates a robot to a robot group it belongs to. Read as part-to-whole, consistent with SUMO:member and CORA:robotPart."@en .


#################################################################
#
#    ALIGNMENT WITH WADL (REST call interface)
#
#    CSS has the call interface of a skill (CSS:SkillInterface) and CaSk the
#    technology-independent trigger (CaSk:SkillMethod). Neither carries the
#    address: base URI, path and HTTP verb. That is what WADL describes, and
#    that part is what is aligned here.
#
#    WADL is a description language: Resources, Resource and Method are
#    elements of a document, not the interface itself. The axioms towards the
#    WADL side are therefore relations throughout, not subclass axioms -- the
#    same distinction IEEE 1872.2 makes between an environment and its
#    description.
#
#################################################################

###  http://www.w3id.org/hsu-aut/caskbot#RestSkillInterface
# Mechanism: subclassing (CSS <-> class of our own). Named as in
# CaSkMan:RestSkillInterface, so that the third level stays uniform.
:RestSkillInterface rdf:type owl:Class ;
                    rdfs:subClassOf CSS:SkillInterface ;
                    rdfs:label "REST skill interface"@en ;
                    rdfs:comment "A skill interface that is accessed as a RESTful web service over HTTP. Its address is described with the WADL ODP: the base URI comes from the resources element, the path from a resource and the verb from a method (WADL, W3C Member Submission 31 August 2009, 2.6 to 2.8)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#accessibleThroughRestInterface
# Mechanism: Relation-to (CSS <-> class of our own), as in
# CaSkMan:accessibleThroughRestInterface.
:accessibleThroughRestInterface rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf CSS:accessibleThrough ;
                                rdfs:domain CSS:Skill ;
                                rdfs:range :RestSkillInterface ;
                                rdfs:label "accessible through REST interface"@en ;
                                rdfs:comment "Relates a skill to a REST interface through which it can be invoked. Specialisation of CSS:accessibleThrough."@en .


###  http://www.w3id.org/hsu-aut/caskbot#describesRestSkillInterface
# Mechanism: Relation-to (WADL <-> CSS), from the description to the thing
# described, as with :describesEnvironment. A WADL document knows nothing
# about skills, so the standard offers no such relation.
:describesRestSkillInterface rdf:type owl:ObjectProperty ;
                             rdfs:domain WADL:Resources ;
                             rdfs:range :RestSkillInterface ;
                             rdfs:label "describes REST skill interface"@en ;
                             rdfs:comment "Relates a WADL resources element to the REST skill interface it describes. The base attribute of that element carries the address under which the interface is reachable (WADL 2.6). This is a relation and not a subclass axiom, because a WADL element describes an interface but is not one."@en .


###  http://www.w3id.org/hsu-aut/caskbot#invokedByHttpMethod
# Mechanism: Relation-to (CaSk <-> WADL). Without a superproperty:
# CSS:isRealizedBy carries a domain union that does not include SkillMethod,
# so placing this property under it would force CaSk:SkillMethod into that
# union.
:invokedByHttpMethod rdf:type owl:ObjectProperty ;
                     rdfs:domain CaSk:SkillMethod ;
                     rdfs:range WADL:Method ;
                     rdfs:label "invoked by HTTP method"@en ;
                     rdfs:comment "Relates a skill method, which is the technology-independent trigger of a state transition in CaSk, to the HTTP method that invokes it. Together with the path of the WADL resource carrying that method and the base URI of the enclosing resources element, this gives the complete call address."@en .


#################################################################
#
#    ALIGNMENT WITH ROBOTCAPABILITIES
#
#    The RobotCapabilities pattern carries the types of capability an
#    autonomous robot can provide and imports nothing, so that it stays
#    reusable with any capability model. The one axiom that binds it to this
#    stack is here.
#
#################################################################

###  http://www.w3id.org/hsu-aut/RobotCapabilities#RobotCapability
# The root of the pattern is a capability in the sense of CSS: an
# implementation-independent specification of a function. The nine types below
# it -- perception, locomotion, manipulation, reasoning, communication and
# their subtypes -- are thereby capabilities a resource can provide through
# CSS:providesCapability, without the pattern itself depending on CSS.
# Mechanism: subclassing (RobotCapabilities -> CSS)
RobotCap:RobotCapability rdfs:subClassOf CSS:Capability .


#################################################################
#
#    ALIGNMENT WITH MQTT (publish/subscribe call interface)
#
#    The counterpart of the WADL section for the second interface technology
#    that CaSk leaves open. A skill reached over MQTT is not called at a URI
#    but triggered by publishing to a topic on a broker, so the address
#    consists of the broker and the topic.
#
#    As on the REST side, only the invocation is aligned: the interface, the
#    topic that triggers a transition and the broker it is reached at. The
#    subscription side of MQTT -- maximum QoS, topic filters, sessions --
#    stays unaligned; the MQTT ODP models it, but nothing in this ontology
#    asks a question that needs it.
#
#    MQTT:MQTTClient is not aligned either. A client is a program that speaks
#    the protocol, an interface is the way a skill is addressed; the two are
#    related in a deployment but are not the same thing.
#
#################################################################

###  http://www.w3id.org/hsu-aut/caskbot#MqttSkillInterface
# Mechanism: subclassing (CSS <-> class of our own), named as its REST
# counterpart :RestSkillInterface.
:MqttSkillInterface rdf:type owl:Class ;
                    rdfs:subClassOf CSS:SkillInterface ;
                    rdfs:label "MQTT skill interface"@en ;
                    rdfs:comment "A skill interface that is accessed by publishing MQTT control packets. Its address consists of the server the interface is reached at and the topic a message is published to (MQTT Version 5.0, 1.2, 3.3.2.1)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#accessibleThroughMqttInterface
# Mechanism: Relation-to (CSS <-> class of our own), as
# :accessibleThroughRestInterface.
:accessibleThroughMqttInterface rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf CSS:accessibleThrough ;
                                rdfs:domain CSS:Skill ;
                                rdfs:range :MqttSkillInterface ;
                                rdfs:label "accessible through MQTT interface"@en ;
                                rdfs:comment "Relates a skill to an MQTT interface through which it can be invoked. Specialisation of CSS:accessibleThrough."@en .


###  http://www.w3id.org/hsu-aut/caskbot#invokedByTopic
# Mechanism: Relation-to (CaSk <-> MQTT). Without a superproperty, for the
# same reason as :invokedByHttpMethod.
:invokedByTopic rdf:type owl:ObjectProperty ;
                rdfs:domain CaSk:SkillMethod ;
                rdfs:range MQTT:Topic ;
                rdfs:label "invoked by topic"@en ;
                rdfs:comment "Relates a skill method, which is the technology-independent trigger of a state transition in CaSk, to the MQTT topic an application message is published to in order to invoke it. A topic name is the label a message is matched against the subscriptions of the server (MQTT Version 5.0, 1.2)."@en .


###  http://www.w3id.org/hsu-aut/caskbot#reachableViaMqttServer
# Mechanism: Relation-to (CSS <-> MQTT). The MQTT counterpart of the base URI
# that :describesRestSkillInterface reaches on the REST side. A broker is a
# thing, not a description of one, so the relation runs from the interface to
# the server rather than the other way round.
:reachableViaMqttServer rdf:type owl:ObjectProperty ;
                        rdfs:domain :MqttSkillInterface ;
                        rdfs:range MQTT:MQTTServer ;
                        rdfs:label "reachable via MQTT server"@en ;
                        rdfs:comment "Relates an MQTT skill interface to the server through which it is reached. Together with the topic that invokes a transition, the URI of that server gives the complete call address."@en .


#################################################################
#
#    ALIGNMENT WITH GEOSPARQL (spatial extent of zones)
#
#    Used from OGC GeoSPARQL 1.1 (OGC 22-047r1): Feature, Geometry,
#    hasGeometry, asWKT, wktLiteral.
#
#################################################################

# Mechanism: subclassing (IEEE 1872 POS -> GeoSPARQL)
POS:PositionRegion rdfs:subClassOf geo:Geometry .


###  http://www.w3id.org/hsu-aut/caskbot#Zone
# Mechanism: subclassing (class of our own -> GeoSPARQL)
:Zone rdf:type owl:Class ;
      rdfs:subClassOf geo:Feature ;
      rdfs:label "zone"@en ;
      rdfs:comment "A spatial phenomenon within an environment that restricts or permits the operation of robots. Its extent is given through geo:hasGeometry."@en .


###  http://www.w3id.org/hsu-aut/caskbot#OperatingZone
:OperatingZone rdf:type owl:Class ;
               rdfs:subClassOf :Zone ;
               rdfs:label "operating zone"@en ;
               rdfs:comment "A zone in which a robot may operate. Outside the operating zones that apply to it, operation is not permitted."@en .


###  http://www.w3id.org/hsu-aut/caskbot#zoneAppliesTo
# Mechanism: Relation-to (classes of our own)
:zoneAppliesTo rdf:type owl:ObjectProperty ;
               rdfs:domain :Zone ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :Platform :AutonomousRobot )
                          ] ;
               rdfs:label "zone applies to"@en ;
               rdfs:comment "Relates a zone to the platform kind or the individual robot it holds for."@en .


#################################################################
#    Disjointness
#################################################################

# A platform has exactly one modality.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AerialPlatform :GroundPlatform :SurfacePlatform )
] .


#################################################################
#
#    Position, orientation and pose -- no axioms of our own
#
#    POS already provides what is needed, and its relations apply to robots
#    without an alignment axiom:
#        positionedAt     Object -> PositionMeasure
#        orientedAt       Object -> OrientationMeasure
#        pose             Object -> PoseMeasure
#        posePosition     PoseMeasure -> PositionMeasure
#        poseOrientation  PoseMeasure -> OrientationMeasure
#        inPCS / inOCS    frame of reference, both functional
#        refPCS / refOCS  anchors a coordinate system to an object
#
#    All three assignment properties have domain sumo-cora:Object, and
#        Robot ⊑ Device ⊑ Artifact ⊑ CorpuscularObject
#              ⊑ SelfConnectedObject ⊑ Object
#
#################################################################


